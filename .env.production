# Used by `next build` (picked up automatically for both the Electron
# package build and the Vercel deployment, since they share this codebase).
# Not a secret — just the backend's public URL, safe to commit and safe to
# embed in the distributed Electron build. No SUPABASE_SERVICE_ROLE_KEY or
# ADMIN_SECRET belongs in this file, ever — those stay only in Vercel's own
# environment variables.
NEXT_PUBLIC_API_BASE_URL=https://royal-optical-dashboard.vercel.app
