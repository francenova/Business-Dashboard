# ---- Supabase (required for the dashboard to run) ----
# Copy this file to .env.local and fill in your own project's real values
# from Supabase Dashboard -> Project Settings -> API. Never commit the real
# values — .env.local is gitignored for exactly that reason.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ---- Backend only — NEVER present in the Electron-packaged build ----
# Used exclusively by app/api/** route handlers (server-side) and by
# middleware.ts to look up device tokens. These three belong only on the
# backend deployment (Vercel), never in any client-shipped file.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used only by you, manually, to call /api/admin/devices/* (create a device
# enrollment token, revoke a device). Generate a long random value and keep
# it only in your Vercel project's env vars and your own notes — it is
# never shipped in the Electron app.
ADMIN_SECRET=generate-a-long-random-value

# Upstash Redis (REST) — powers rate limiting in middleware.ts. Free tier at
# https://upstash.com. If left unset, rate limiting is simply skipped
# (device-token auth still applies) rather than breaking the app — but it
# should be configured on the real deployment.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Electron build only ----
# The deployed backend's public URL. Not a secret — safe to bundle into the
# Electron build. Leave unset for local `next dev` (calls stay relative/
# local in that case — see lib/apiFetch.ts).
NEXT_PUBLIC_API_BASE_URL=

# ---- Local development only ----
# Lets `npm run dev` work without enrolling a device first. NEVER set this
# on the Vercel deployment or anywhere else it could be mistaken for
# production — device-token enforcement is ON by default specifically so
# forgetting this elsewhere can't silently disable it.
DISABLE_DEVICE_AUTH_FOR_LOCAL_DEV=true
