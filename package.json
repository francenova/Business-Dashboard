{
  "name": "royal-optical-dashboard",
  "productName": "Royal Optical Dashboard",
  "description": "Royal Opticals clinic-management dashboard",
  "author": "Royal Opticals",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/copy-standalone-assets.js",
    "start": "next start",
    "lint": "next lint",
    "electron:dev": "concurrently -k -s first \"next dev\" \"wait-on http://localhost:3000 && cross-env ELECTRON_DEV_URL=http://localhost:3000 electron .\"",
    "electron:pack": "npm run build && electron-builder --win --dir",
    "electron:build": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.40.0",
    "electron-updater": "^6.3.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/postcss": "^4.1.14",
    "@tanstack/react-query": "^5.101.4",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "html2canvas-pro": "^2.3.7",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.7.3",
    "wait-on": "^8.0.1",
    "xlsx": "^0.18.5"
  },
  "browserslist": [
    "> 0.2% and not dead"
  ]
}
